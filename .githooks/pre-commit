#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "BLOCKED: gitleaks is required. Install it before committing." >&2
  echo "See SECURITY.md for verified installation and scan commands." >&2
  exit 1
fi

if git diff --cached --quiet --exit-code; then
  exit 0
fi

echo "Security: scanning the exact staged patch with Gitleaks..."
if ! git diff --cached --binary --no-ext-diff | gitleaks stdin --config .gitleaks.toml --redact --no-banner; then
  echo "BLOCKED: a possible secret was detected in staged changes." >&2
  echo "Unstage the file, remove the secret, rotate it if exposed, and scan again." >&2
  exit 1
fi

echo "Security: staged secret scan passed."

